    { "kind": "advanced", "heading": "Watch the Corner Vanish",
      "tex": { "fg": "f\\,g", "side": { "tex": "g\\,\\Delta f", "color": "blue" }, "top": { "tex": "f\\,\\Delta g", "color": "tangerine" }, "corner": { "tex": "\\Delta f\\,\\Delta g", "color": "grey", "size": 40 } },
      "builds": [ { "start": { "chunk": 1, "phrase": "Now let" } }, { "start": { "chunk": 1, "phrase": "and watch" } } ],
      "code": "const k = 1 - info.ease.inOut(info.progress(info.builds[1] ?? 3, 3));\nconst x0 = 420, y0 = 210, W = 700, H = 340;\nconst dw = 12 + 190 * k, dh = 8 + 110 * k;\nctx.lineWidth = 3;\nctx.fillStyle = info.colors.blue; ctx.globalAlpha = 0.14; ctx.fillRect(x0, y0, W, H);\nctx.globalAlpha = 0.35; ctx.fillRect(x0 + W, y0, dw, H);\nctx.fillStyle = info.colors.tangerine; ctx.globalAlpha = 0.3; ctx.fillRect(x0, y0 - dh, W, dh);\nctx.fillStyle = info.colors.grey; ctx.globalAlpha = 0.35; ctx.fillRect(x0 + W, y0 - dh, dw, dh);\nctx.globalAlpha = 1; ctx.strokeStyle = info.colors.navy;\nctx.strokeRect(x0, y0, W, H); ctx.strokeRect(x0 + W, y0, dw, H); ctx.strokeRect(x0, y0 - dh, W, dh); ctx.strokeRect(x0 + W, y0 - dh, dw, dh);\ninfo.math('fg', x0 + W / 2, y0 + H / 2);\ninfo.math('side', x0 + W + dw + 20, y0 + H / 2, { align: 'left' });\ninfo.math('top', x0 + W / 2, y0 - dh - 30);\ninfo.math('corner', x0 + W + dw + 20, y0 - dh / 2 - 30, { align: 'left', alpha: 0.3 + 0.7 * k });\ninfo.text('area of the corner: ' + (dw * dh / 1000).toFixed(1), x0 + W / 2, y0 + H + 60, { size: 30, color: info.colors.grey });"
    }
